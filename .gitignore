# Secrets
.env
.env.*
!.env.example
api_keys.json
**/api_keys.json

# Python
.venv/
.venv-docling-graph/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Mutable model runs remain local until deliberately frozen.
runs/*/raw/
runs/*/*.jsonl
runs/*/*.csv

# Downloaded full texts can be large and may have redistribution restrictions.
# Keep retrieval manifests and target lists versioned, but not article binaries.
data/full_text/**/files/
data/full_text/**/raw_metadata/
data/full_text/**/selected_files/

# Docling Graph conversions and raw model traces are reproducible local artifacts.
# Version only compact manifests, aggregate QA tables, and methodology notes.
data/full_text_graph/**/converted/
data/full_text_graph/**/artifacts/
data/full_text_graph/**/audit/
data/full_text_graph/**/codex_adapter.log

# Full-text screening packets contain article text. Version their hashes and
# compact ledgers, not the packets or raw model responses.
data/full_text_screening/**/input.jsonl
data/full_text_screening/**/shards/
data/full_text_screening/**/runs/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
