{
  "schema_version": "1.0.0",
  "corpus": {
    "retrieval_manifest": "data/full_text/v1.1.2_priority_1_nonpreprint_119/retrieval_manifest.jsonl",
    "expected_retrieval_candidates": 98,
    "expected_sufficient_full_texts_after_conversion": 97,
    "accepted_statuses": ["downloaded_pdf", "downloaded_html", "downloaded_xml"],
    "full_text_sufficiency_gate": {
      "minimum_markdown_bytes": 1000,
      "failure_route": "insufficient_full_text",
      "model_input_allowed": false
    }
  },
  "docling_graph": {
    "package_version": "1.9.1",
    "upstream_commit_observed": "efb67d8458d693d3a6b3490f7471441669c05b2d",
    "template": "scripts.docling_graph.templates.causal_multiomics_aging.CausalMultiomicsAgingPaper",
    "backend": "llm",
    "inference": "remote",
    "provider": "openai",
    "processing_mode": "many-to-one",
    "extraction_contract": "direct",
    "fallback_contract_on_context_overflow": "dense",
    "llm_input_format": "markdown",
    "use_chunking": true,
    "chunk_max_tokens": 1024,
    "dense_skeleton_batch_tokens": 6144,
    "dense_fill_nodes_cap": 8,
    "dense_fill_context": "scoped",
    "dense_dedupe": "standard",
    "parallel_workers": 1,
    "gleaning_enabled": false,
    "provenance": "detailed",
    "structured_output": true,
    "structured_sparse_check": false,
    "llm_overrides": {
