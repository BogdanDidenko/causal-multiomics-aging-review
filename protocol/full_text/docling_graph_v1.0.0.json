      },
      "context_limit": 128000,
      "max_output_tokens": 8000
    },
    "export_docling_json": true,
    "export_markdown": true,
    "export_doclang": true
  },
  "conversion": {
    "preconvert_once": true,
    "pdf_ocr": false,
    "pdf_table_structure": true,
    "pdf_table_mode": "accurate",
    "generate_page_images": false,
    "generate_picture_images": false,
    "reuse_existing_docling_graph_exports": true
  },
  "model": {
    "codex_cli_model": "gpt-5.6-luna",
    "reasoning_effort": "low",
    "display_name": "GPT 5.6 Luna Light",
    "temperature_control": "not_exposed_by_codex_cli",
    "purpose": "evidence graph extraction only; no eligibility or evidence-level decision"
  },
  "runtime": {
    "base_url": "http://127.0.0.1:8766/v1",
    "timeout_seconds": 600,
    "max_retries": 1,
    "resume": true,
    "output_root": "data/full_text_graph/v1.0.0_luna_light"
  }
