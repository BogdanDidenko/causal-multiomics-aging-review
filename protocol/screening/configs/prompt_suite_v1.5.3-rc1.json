        "priority_text_terms": ["mendelian random", "instrumental variable", "intervention", "perturb", "crispr", "knockout", "mediation", "causal", "directed acyclic", "structural equation", "bayesian network", "omics", "aging", "ageing", "longevity", "lifespan", "senescence"]
