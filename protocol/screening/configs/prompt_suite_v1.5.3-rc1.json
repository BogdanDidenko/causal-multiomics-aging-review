          "template_role": "causal_method_reviewer",
          "evidence_profile": "evidence_profiles/v1.5.3-rc1/full_text_sections.json",
          "schema": "schemas/full_text/v1.4.0-rc1/causal_method_reviewer.schema.json"
        }
      },
      "level_labels": {
        "0": "context_only",
        "1": "associational",
        "2": "causal_hypothesis",
        "3": "causal_evidence",
        "4": "causal_evidence_validated"
