      "routing": {
        "five_of_five_scope_exclusion": "exclude",
        "five_of_five_causal_exclusion": "exclude",
        "five_of_five_positive_causal_basis": "assessed",
        "five_of_five_same_scope_status_pass": "run_causal_method_reviewer",
        "taxonomy_field_disagreement": "preserve_in_audit_without_changing_route",
