      "deterministic_evidence_grounding": {
        "strategy": "same_chunk_whitespace_then_longest_contiguous_word_span",
        "minimum_words": 3,
        "semantic_matching": false,
        "failure_route": "retry_then_manual_review"
      },
      "roles": {
        "scope_reviewer": {
