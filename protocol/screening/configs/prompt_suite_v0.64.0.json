{
  "schema_version": "1.2.0",
  "suite_id": "causal_multiomics_aging_screening",
  "suite_version": "0.64.0",
  "provider": {
    "protocol": "codex_cli",
    "codex_bin": "codex",
    "codex_cli_version": "codex-cli 0.145.0",
    "model": "gpt-5.6-terra",
    "display_name": "GPT 5.6 Terra Medium",
    "sandbox": "read-only",
    "approval_policy": "never",
    "ephemeral": true,
    "ignore_user_config": true,
    "ignore_rules": true,
    "isolated_home": true,
    "disabled_features": ["plugins"]
  },
  "runtime": {
    "provider_protocol": "codex_cli",
    "reasoning_effort": "medium",
    "context_window": 32768,
    "codex_timeout_seconds": 900,
    "max_retries": 1,
    "response_format": "json_schema"
  },
  "stages": {
    "title_abstract": {
      "input_format": "csv",
      "max_tokens": 4000,
      "max_input_abstract_chars": 5000,
      "gate_precedence": "exclude_then_unclear",
      "identification_status_contract": "causal_candidate_split_v4",
      "prisma_scope_short_circuit_round_a": true,
      "title_scope_sequential_short_circuit": true,
      "title_layer_inventory": "deferred_to_full_text",
      "roles": {
        "scope_reviewer": {
          "prompt": "prompts/title_abstract/v0.64.0/scope_reviewer.txt",
          "schema": "schemas/title_abstract/v0.64.0/scope_reviewer.schema.json",
          "exclude_if": [
            {"field": "report_type", "equals": "nonempirical"},
            {"field": "bio_health_scope", "equals": "no"},
            {"field": "aging_process_relevance", "equals": "no"},
            {"field": "multiomics_status", "equals": "no"}
          ],
          "unclear_if": [
            {"field": "report_type", "equals": "unclear"},
            {"field": "bio_health_scope", "equals": "unclear"},
            {"field": "aging_process_relevance", "equals": "unclear"},
            {"field": "multiomics_status", "equals": "unclear"}
          ]
        },
        "causal_design_reviewer": {
          "prompt": "prompts/title_abstract/v0.64.0/causal_design_reviewer.txt",
          "schema": "schemas/title_abstract/v0.64.0/causal_design_reviewer.schema.json",
          "exclude_if": [
            {"field": "identification_status", "equals": "noncausal"}
          ],
          "unclear_if": [
            {"field": "identification_status", "equals": "unclear"}
          ]
        },
        "directional_result_reviewer": {
          "prompt": "prompts/title_abstract/v0.64.0/directional_result_reviewer.txt",
          "schema": "schemas/title_abstract/v0.64.0/directional_result_reviewer.schema.json",
          "exclude_if": [],
          "unclear_if": []
        }
      },
      "adjudication": {
        "prompt": "prompts/title_abstract/v0.64.0/adjudicator.txt",
        "schema": "schemas/title_abstract/v0.64.0/adjudicator.schema.json",
        "exclude_if": [
          {"field": "report_type", "equals": "nonempirical"},
          {"field": "bio_health_scope", "equals": "no"},
          {"field": "aging_process_relevance", "equals": "no"},
          {"field": "multiomics_status", "equals": "no"},
          {"field": "identification_status", "equals": "noncausal"}
        ],
        "unclear_if": [
          {"field": "report_type", "equals": "unclear"},
          {"field": "bio_health_scope", "equals": "unclear"},
          {"field": "aging_process_relevance", "equals": "unclear"},
          {"field": "multiomics_status", "equals": "unclear"},
          {"field": "identification_status", "equals": "unclear"}
        ]
      },
      "routing": {
        "round_a_all_include": "seek_full_text",
        "round_a_any_exclude": "exclude",
        "round_a_any_unclear": "adjudicate",
        "round_a_otherwise": "adjudicate",
        "adjudicated_include": "seek_full_text",
        "adjudicated_exclude": "exclude",
        "adjudicated_unclear": "seek_full_text"
      }
    },
    "full_text": {
      "input_format": "jsonl",
      "max_tokens": 16000,
      "gate_precedence": "exclude_then_unclear",
      "section_selector": {
        "prompt": "prompts/full_text/v0.1.0/section_selector.txt",
        "schema": "schemas/full_text/v0.1.0/section_selector.schema.json"
      },
      "roles": {
        "eligibility_reviewer": {
          "prompt": "prompts/full_text/v0.1.0/eligibility_reviewer.txt",
          "schema": "schemas/full_text/v0.1.0/eligibility_reviewer.schema.json",
          "exclude_if": [
            {"field": "empirical_primary", "equals": "no"},
            {"field": "bio_health_scope", "equals": "no"},
            {"field": "aging_process_relevance", "equals": "no"},
            {"field": "multiomics_status", "equals": "no"},
            {"field": "relevant_causal_design", "equals": "no"}
          ],
          "unclear_if": [
            {"field": "empirical_primary", "equals": "unclear"},
            {"field": "bio_health_scope", "equals": "unclear"},
            {"field": "aging_process_relevance", "equals": "unclear"},
            {"field": "aging_role", "equals": "unclear"},
            {"field": "multiomics_status", "equals": "unclear"},
            {"field": "relevant_causal_design", "equals": "unclear"},
            {"field": "full_text_sufficient", "in": ["no", "unclear"]}
          ]
        },
        "causal_evidence_reviewer": {
          "prompt": "prompts/full_text/v0.1.0/causal_evidence_reviewer.txt",
          "schema": "schemas/full_text/v0.1.0/causal_evidence_reviewer.schema.json",
          "exclude_if": [
            {"field": "identification_status", "in": ["association_only", "not_applicable"]}
          ],
          "unclear_if": [
            {"field": "identification_status", "equals": "unclear"},
            {"field": "estimand_complete", "equals": "unclear"},
            {"field": "assumptions_assessable", "equals": "unclear"},
            {"field": "validation_strength", "equals": "unclear"}
          ]
        }
      },
      "adjudication": {
        "prompt": "prompts/full_text/v0.1.0/adjudicator.txt",
        "schema": "schemas/full_text/v0.1.0/adjudicator.schema.json",
        "exclude_if": [
          {"field": "empirical_primary", "equals": "no"},
          {"field": "bio_health_scope", "equals": "no"},
          {"field": "aging_process_relevance", "equals": "no"},
          {"field": "multiomics_status", "equals": "no"},
          {"field": "relevant_causal_design", "equals": "no"},
          {"field": "identification_status", "in": ["association_only", "not_applicable"]}
        ],
        "unclear_if": [
          {"field": "empirical_primary", "equals": "unclear"},
          {"field": "bio_health_scope", "equals": "unclear"},
          {"field": "aging_process_relevance", "equals": "unclear"},
          {"field": "aging_role", "equals": "unclear"},
          {"field": "multiomics_status", "equals": "unclear"},
          {"field": "full_text_sufficient", "in": ["no", "unclear"]},
          {"field": "identification_status", "equals": "unclear"},
          {"field": "estimand_complete", "equals": "unclear"},
          {"field": "assumptions_assessable", "equals": "unclear"},
          {"field": "validation_strength", "equals": "unclear"}
        ]
      },
      "routing": {
        "round_a_all_include": "assessed",
        "round_a_otherwise": "adjudicate",
        "adjudicated_include": "assessed",
        "adjudicated_exclude": "assessed",
        "adjudicated_unclear": "manual_review"
      }
    }
  },
  "evidence_level_rules": {
    "analytic_levels": [2, 3, 4],
    "labels": {
      "0": "context_only",
      "1": "associational",
      "2": "causal_hypothesis",
      "3": "causal_evidence",
      "4": "causal_evidence"
    }
  },
  "stability_policy": {
    "model": "gpt-5.6-terra",
    "repeats": 5,
    "agent_stages": [
      "scope_reviewer",
      "causal_design_reviewer",
      "directional_result_reviewer",
      "title_abstract_adjudicator",
      "section_selector",
      "fulltext_eligibility_reviewer",
      "causal_evidence_reviewer",
      "fulltext_adjudicator"
    ],
    "acceptance": {
      "schema_success_rate": 1.0,
      "final_decision_exact_agreement": 1.0,
      "decisive_criteria_exact_agreement": 1.0,
      "all_tracked_criteria_exact_agreement": 1.0,
      "causal_evidence_level_exact_agreement": 1.0,
      "manual_review_rate": 0.0
    },
    "on_instability": "localize_disagreeing_criterion_then_revise_prompt_version"
  }
}
