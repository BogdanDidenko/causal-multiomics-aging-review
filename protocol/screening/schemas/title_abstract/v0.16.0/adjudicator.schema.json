{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_type",
    "bio_health_scope",
    "aging_process_relevance",
    "aging_intervention_target_analyzed",
    "longevity_or_healthspan_analyzed",
    "aging_measure_or_trajectory_analyzed",
    "aging_mechanism_analyzed",
    "aging_role",
    "multiomics_status",
    "same_sample_or_participants",
    "distinct_molecular_datasets_linked",
    "cross_layer_operation_reported",
    "integration_mode",
    "omics_layers",
    "causal_claim_present",
    "identification_status",
    "design_families",
    "design_role",
    "exposure_or_intervention",
    "comparator",
    "outcome",
    "estimand_or_contrast",
    "resolution_status",
    "evidence_spans",
    "boundary_cases",
    "uncertainty_reason",
    "concise_rationale"
  ],
  "properties": {
    "report_type": {
      "enum": ["empirical_primary", "review_editorial", "protocol", "methods_only", "resource", "unclear"]
    },
    "bio_health_scope": {"enum": ["yes", "no", "unclear"]},
    "aging_process_relevance": {"enum": ["yes", "no", "unclear"]},
    "aging_intervention_target_analyzed": {
      "description": "Whether this report applies or evaluates an intervention intended to alter an aging construct.",
      "enum": ["yes", "no", "unclear"]
    },
    "longevity_or_healthspan_analyzed": {
      "description": "Whether longevity, lifespan, healthspan, or exceptional longevity is analyzed.",
      "enum": ["yes", "no", "unclear"]
    },
    "aging_measure_or_trajectory_analyzed": {
      "description": "Whether an aging measure, clock, age acceleration, or change/comparison explicitly framed as aging is analyzed.",
      "enum": ["yes", "no", "unclear"]
    },
    "aging_mechanism_analyzed": {
      "description": "Whether a molecular or cellular mechanism explicitly framed as aging or cellular senescence is analyzed.",
      "enum": ["yes", "no", "unclear"]
    },
    "aging_role": {
      "enum": [
        "aging_outcome_or_trajectory",
        "longevity_or_healthspan",
        "aging_mechanism",
        "aging_intervention_target",
        "age_context_only",
        "unclear"
      ]
    },
    "multiomics_status": {"enum": ["yes", "no", "unclear"]},
    "same_sample_or_participants": {
      "description": "Whether at least two layers are explicitly measured in the same participants, specimens, cells, paired aliquots, or one specified multi-omics sample collection.",
      "enum": ["yes", "no", "unclear"]
    },
    "distinct_molecular_datasets_linked": {
      "description": "Whether the analysis links molecular layers assigned to distinct datasets, cohorts, sample collections, QTL resources, or summary-statistic sources.",
      "enum": ["yes", "no", "unclear"]
    },
    "cross_layer_operation_reported": {
      "description": "Yes for an explicit operation relating layers; no for two or more separately reported layer-specific findings without such an operation; unclear for a generic multi-omics label or layer list without enough analytic detail.",
      "enum": ["yes", "no", "unclear"]
    },
    "integration_mode": {
      "enum": [
        "same_study_joint_integration",
        "same_study_parallel_measurement",
        "cross_dataset_integrated",
        "external_context_only",
        "single_layer_only",
        "unclear"
      ]
    },
    "omics_layers": {
      "type": "array",
      "items": {"$ref": "#/$defs/omics_layer"}
    },
    "causal_claim_present": {"enum": ["yes", "no", "unclear"]},
    "identification_status": {
      "enum": ["identified", "hypothesis_only", "association_only", "no_relevant_design", "unclear"]
    },
    "design_families": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/design_family"}
    },
    "design_role": {
      "enum": ["primary_identification", "supporting_identification", "hypothesis_generation", "validation_only", "mentioned_only", "unclear"]
    },
    "exposure_or_intervention": {"type": "string"},
    "comparator": {"type": "string"},
    "outcome": {"type": "string"},
    "estimand_or_contrast": {"type": "string"},
    "resolution_status": {
      "enum": ["resolved", "insufficient_title_abstract", "conflict_unresolved"]
    },
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "#/$defs/title_abstract_evidence"}
    },
    "boundary_cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "uncertainty_reason": {"type": "string"},
    "concise_rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "omics_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer", "raw_term", "use_status", "analytic_role"],
      "properties": {
        "layer": {
          "enum": ["genomics", "epigenomics", "transcriptomics", "proteomics", "metabolomics", "lipidomics", "microbiomics", "other_molecular_omics"]
        },
        "raw_term": {"type": "string", "minLength": 1},
        "use_status": {"enum": ["measured_in_study", "external_dataset_analyzed", "context_only", "unclear"]},
        "analytic_role": {"type": "string"}
      }
    },
    "design_family": {
      "enum": ["genetic_instrument", "randomized_intervention", "nonrandomized_intervention", "direct_perturbation", "temporal_design", "formal_mediation", "graphical_or_directed_model", "other"]
    },
    "title_abstract_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "source", "quote"],
      "properties": {
        "criterion": {"type": "string"},
        "source": {"enum": ["title", "abstract", "metadata"]},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  }
}
