{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intervention_design_signal",
    "evidence_spans",
    "uncertainty_reason",
    "concise_rationale"
  ],
  "properties": {
    "intervention_design_signal": {"enum": ["yes", "no", "unclear"]},
    "evidence_spans": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "uncertainty_reason": {"type": "string"},
    "concise_rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "source", "quote"],
      "properties": {
        "criterion": {
          "type": "string",
          "const": "intervention_design_signal"
        },
        "source": {"enum": ["title", "abstract", "metadata"]},
        "quote": {"type": "string", "minLength": 1}
      }
    }
  }
}
