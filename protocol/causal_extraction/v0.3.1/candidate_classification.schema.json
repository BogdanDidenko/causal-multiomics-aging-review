{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/causal-multiomics-aging/candidate-classification-v0.3.1.schema.json",
  "title": "Fixed candidate causal-analysis classification v0.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "source_status", "candidates"],
  "properties": {
    "report_id": {"type": "string", "minLength": 1},
    "source_status": {
      "type": "string",
      "enum": ["sufficient", "insufficient_or_corrupt"]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "qualification",
          "first_failed_condition",
          "causal_basis",
          "design_family",
          "variation_source",
          "aging_role",
          "multiomics_role",
          "contrast_status",
          "assumptions_reviewability",
          "result_status",
          "validation_strength"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^cc_v031_[0-9]{3}_[0-9]{2}$"
          },
          "qualification": {
            "type": "string",
            "enum": ["include", "exclude", "unclear"]
          },
          "first_failed_condition": {
            "type": "string",
            "enum": [
              "none",
              "not_current_report",
              "no_empirical_result",
              "no_aging_relevance",
              "no_named_causal_basis",
              "not_multiomics_workflow",
              "not_distinct_design_unit",
              "insufficient_evidence"
            ]
          },
          "causal_basis": {
            "type": "string",
            "enum": [
              "effect_identification_design",
              "formal_directed_hypothesis",
              "not_applicable"
            ]
          },
          "design_family": {
            "type": "string",
            "enum": [
              "genetic_instrument",
              "randomized_intervention",
              "nonrandomized_controlled_intervention",
              "targeted_perturbation",
              "mediation",
              "temporal_design",
              "graphical_or_structural_model",
              "causal_discovery_algorithm",
              "other_named_design",
              "not_applicable"
            ]
          },
          "variation_source": {
            "type": "string",
            "enum": [
              "randomized_assignment",
              "genetic_instrument",
              "genetic_perturbation",
              "molecular_perturbation",
              "pharmacologic_intervention",
              "behavioral_or_environmental_intervention",
              "surgical_or_model_induction",
              "temporal_ordering",
              "modeled_directionality",
              "other_named_source",
              "not_applicable"
            ]
          },
          "aging_role": {
            "type": "string",
            "enum": [
              "lifespan_or_longevity_outcome",
              "biological_or_chronological_aging_outcome",
              "cellular_senescence_outcome",
              "age_related_disease_or_decline_outcome",
              "mechanistic_support_for_aging_link",
              "not_applicable"
            ]
          },
          "multiomics_role": {
            "type": "string",
            "enum": [
              "omics_exposure_in_causal_design",
              "multiomics_outcomes_under_causal_design",
              "omics_candidate_followed_by_perturbation",
              "formal_cross_omics_directed_model",
              "report_level_multiomics_support",
              "not_applicable"
            ]
          },
          "contrast_status": {
            "type": "string",
            "enum": ["explicit", "implicit", "unclear", "not_applicable"]
          },
          "assumptions_reviewability": {
            "type": "string",
            "enum": [
              "reviewable",
              "partly_reviewable",
              "not_reviewable",
              "not_applicable"
            ]
          },
          "result_status": {
            "type": "string",
            "enum": ["positive", "null", "mixed", "not_applicable"]
          },
          "validation_strength": {
            "type": "string",
            "enum": [
              "none",
              "supportive_same_experiment",
              "link_specific_colocalization",
              "orthogonal_same_link",
              "independent_replication",
              "unclear",
              "not_applicable"
            ]
          }
        }
      }
    }
  }
}
