{
  "experiment_id": "causal_extraction_v0.3.0_development",
  "suite_version": "0.3.0",
  "status": "pre_first_terra_run_candidate",
  "provider": "codex_cli",
  "model": "gpt-5.6-terra",
  "reasoning_effort": "medium",
  "codex_cli_version": "codex-cli 0.145.0",
  "context_window": 131072,
  "max_rendered_prompt_tokens": 110000,
  "repeats": 5,
  "analysis_views": [3, 5],
  "workers": 4,
  "timeout_seconds": 1200,
  "technical_retry_limit": 1,
  "prompt": "prompt.txt",
  "schema": "analysis_inventory.schema.json",
  "codebook": "codebook.md",
  "packaging": {
    "representation": "all_evidence_atoms_compact_v1",
    "include_every_atom": true,
    "include_section_heading_once": true,
    "preserve_document_order": true,
    "exclude_reference_atoms": false,
    "model_based_selection": false,
    "graph_based_selection": false
  },
  "decision_policy": {
    "target_exact_agreement": 1.0,
    "majority_vote_allowed": false,
    "python_assigns_level": true,
    "model_assigns_level": false,
    "unstable_route": "method_revision_or_human_review"
  },
  "session_policy": {
    "isolated_session_per_call": true,
    "ephemeral_codex_home": true,
    "plugins_enabled": false,
    "ignore_user_config": true,
    "ignore_repository_instructions": true
  }
}
